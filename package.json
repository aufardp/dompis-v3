{
  "name": "dompis-v3-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4",
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p spike/runtime/tsconfig.json && bun run --filter '@dompis/*' typecheck",
    "lint": "eslint . --max-warnings=0 && bun fmt --check package.json tsconfig.json tsconfig.base.json bunfig.toml eslint.config.js apps packages tools/foundation spike/runtime",
    "build": "bun run --filter '@dompis/*' build",
    "test": "bun tools/foundation/unimplemented.ts test",
    "test:parity": "bun tools/foundation/unimplemented.ts test:parity",
    "test:integration": "bun tools/foundation/unimplemented.ts test:integration",
    "test:load": "bun tools/foundation/unimplemented.ts test:load",
    "test:security": "bun tools/foundation/unimplemented.ts test:security",
    "test:schema": "bun tools/foundation/unimplemented.ts test:schema",
    "test:queries": "bun tools/foundation/unimplemented.ts test:queries",
    "check:hunt-report": "bun tools/foundation/unimplemented.ts check:hunt-report",
    "check:retirement": "bun tools/foundation/unimplemented.ts check:retirement",
    "check:no-legacy": "bun tools/foundation/unimplemented.ts check:no-legacy",
    "check:style": "bun tools/foundation/unimplemented.ts check:style",
    "spike:runtime": "bun --no-env-file test ./spike/runtime/runtime.test.ts ./spike/runtime/zod-size.test.ts ./spike/runtime/libraries.test.ts",
    "spike:adapter": "bun --no-env-file test ./spike/runtime/adapter.test.ts",
    "spike:services": "bun --no-env-file test ./spike/runtime/mysql.test.ts ./spike/runtime/redis.test.ts",
    "spike:firebase": "bun --no-env-file test ./spike/runtime/firebase.test.ts",
    "spike:proxy": "bun --no-env-file test ./spike/runtime/proxy.test.ts",
    "spike:all": "bun --no-env-file test ./spike/runtime"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "jose": "6.2.3",
    "bcryptjs": "3.0.3",
    "zod": "4.6.6",
    "node-cron": "4.2.1",
    "elysia": "1.4.30",
    "@sinclair/typebox": "0.34.52",
    "file-type": "22.2.0",
    "openapi-types": "12.1.3",
    "@elysiajs/eden": "1.4.9",
    "sharp": "0.35.5",
    "firebase-admin": "14.3.0",
    "fast-xml-parser": "5.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "drizzle-orm": "0.45.4",
    "mysql2": "3.23.1",
    "ioredis": "5.11.1",
    "bullmq": "5.81.1"
  }
}
